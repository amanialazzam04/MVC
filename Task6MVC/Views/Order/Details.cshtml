
@model Task6MVC.Models.Order

@{
    ViewData["Title"] = "Details";
}

<h1>Order Details</h1>

<h4>Order</h4>
<hr />

<dl class="row">

    <dt class="col-sm-2">Customer Name</dt>
    <dd class="col-sm-10">@Model.CustomerName</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Order Date</dt>
    <dd class="col-sm-10">@Model.OrderDate.ToShortDateString()</dd>

    <dt class="col-sm-2">Total Price</dt>
    <dd class="col-sm-10">@Model.TotalPrice</dd>

    <dt class="col-sm-2">Employee</dt>
    <dd class="col-sm-10">@Model.Employee?.FullName</dd>

</dl>

<a asp-action="Edit" asp-route-id="@Model.Id"
   class="btn btn-warning">Edit</a>

<a asp-action="Index"
   class="btn btn-secondary">Back to List</a>
